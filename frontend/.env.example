# Normal development API base URL.
VITE_API_BASE_URL=http://127.0.0.1:8000

# To use an isolated demo API, create frontend/.env.demo locally (it is ignored
# by Git) with VITE_API_BASE_URL=http://127.0.0.1:8001 and optionally
# VITE_DEMO_BANNER=true. Start Vite with: npm run dev -- --mode demo
# Vite reads .env.demo for that mode; this project does not commit real env files.
