DATABASE_URL=postgresql+psycopg://username:password@host/database?sslmode=require

# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME
# Lock an active user after this many consecutive failed password attempts.
FAILED_LOGIN_ATTEMPT_THRESHOLD=5
# Duration, in minutes, of an account lock after the threshold is reached.
LOGIN_LOCKOUT_MINUTES=15
# "Role must be one of: ADMIN, SALES, WAREHOUSE, ACCOUNTS, VIEWER."
