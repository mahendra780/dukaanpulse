DATABASE_URL=postgresql+psycopg://username:password@host/database?sslmode=require

# By default the backend reads this file. To run an isolated demo backend,
# set DUKAANPULSE_ENV_FILE=.env.demo in the shell before starting Uvicorn and
# create backend/.env.demo locally. Environment files other than this example
# are ignored by Git.

# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME
# Set true ONLY in .env.demo; never in the real .env.
DEMO_SEED_ALLOWED=false
# Lock an active user after this many consecutive failed password attempts.
FAILED_LOGIN_ATTEMPT_THRESHOLD=5
# Duration, in minutes, of an account lock after the threshold is reached.
LOGIN_LOCKOUT_MINUTES=15
# IANA timezone used to determine the reports' business date.
BUSINESS_TIMEZONE=Asia/Kolkata
# "Role must be one of: ADMIN, SALES, WAREHOUSE, ACCOUNTS, VIEWER."
